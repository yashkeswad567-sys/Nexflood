# Indore Flood Intelligence (IFI) Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Auth
SECRET_KEY=indore-flood-intelligence-prod-secret-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Persistence
DATABASE_URL=sqlite:///./indore_flood.db
# For PostgreSQL / PostGIS in Production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indore_flood_gis

# Hydrological Simulation Settings
DEFAULT_RAINFALL_RATE_MMH=32.5
DEFAULT_SOIL_SATURATION_PCT=75.0
KAHN_RIVER_MAX_CONVEYANCE_M3S=45.0
SARASWATI_RIVER_MAX_CONVEYANCE_M3S=28.0

# IoT Telemetry Settings
ESP32_TELEMETRY_INTERVAL_SEC=15
SENSOR_STALE_THRESHOLD_MIN=15

# OpenAI API Key for Indore Flood AI Copilot
OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API Key for High-Resolution Satellite & Aerial Imagery
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
